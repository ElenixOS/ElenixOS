    "lv_chart_series_t": {
      "kind": "managed_resource",
      "category": "tree_dependent",
      "creator": "lv_chart_add_series",
      "reason": "LVGL chart owns series and destroys them with the parent chart."
    },
    "lv_chart_cursor_t": {
      "kind": "managed_resource",
      "category": "tree_dependent",
      "creator": "lv_chart_add_cursor",
      "reason": "LVGL chart owns cursors and destroys them with the parent chart."
    },
    "lv_event_dsc_t": {
      "kind": "managed_resource",
      "category": "tree_dependent",
      "creator": "lv_obj_add_event_cb",
      "reason": "Event descriptors are tied to their owning LVGL object; wrapper invalidation requires the special event binding."
